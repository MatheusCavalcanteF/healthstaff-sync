# Copie para .env (não versionado) e ajuste. Usado pelo docker-compose.yml.

# Chave exigida no cabeçalho X-API-Key. Vazio = sem autenticação (só local).
EXTRACTOR_API_KEY=

# Tamanho máximo de cada arquivo enviado, em MB.
EXTRACTOR_MAX_UPLOAD_MB=20

# Porta publicada em 127.0.0.1 na sua máquina.
EXTRACTOR_PORTA_LOCAL=8000

# --- Banco de dados (container postgres e java-backend) ---
# Obrigatória: o docker compose não sobe sem ela.
POSTGRES_PASSWORD=
POSTGRES_USER=healthstaff
POSTGRES_PORTA_LOCAL=5432

# --- java-backend ---
# Onde o Java encontra o extrator e o banco (padrões servem para rodar local).
EXTRACTOR_URL=http://localhost:8000
DATABASE_URL=jdbc:postgresql://localhost:5432/healthstaff
