# Copie para .env (não versionado) e ajuste. Usado pelo docker-compose.yml.

# producao (padrão) ou desenvolvimento. Em produção o extrator não sobe sem
# EXTRACTOR_API_KEY e não expõe /docs, /redoc nem /openapi.json.
EXTRACTOR_AMBIENTE=producao

# Chave exigida no cabeçalho X-API-Key; a mesma configura o java-backend.
# Obrigatória fora de desenvolvimento. Gere com: openssl rand -hex 32
EXTRACTOR_API_KEY=

# Tamanho máximo de cada arquivo enviado, em MB.
EXTRACTOR_MAX_UPLOAD_MB=20

# Limites de conteúdo por arquivo, conferidos antes da extração (413 se passar):
# .xlsx descompactado (zip bomb) e número de entradas internas; páginas de PDF.
EXTRACTOR_MAX_DESCOMPACTADO_MB=200
EXTRACTOR_MAX_ENTRADAS_ZIP=1000
EXTRACTOR_MAX_PAGINAS_PDF=200

# Porta publicada em 127.0.0.1 na sua máquina.
EXTRACTOR_PORTA_LOCAL=8000

# --- Banco de dados (container postgres e java-backend) ---
# Obrigatória: o docker compose não sobe sem ela.
POSTGRES_PASSWORD=
POSTGRES_USER=healthstaff
POSTGRES_PORTA_LOCAL=5432

# --- java-backend ---
# Onde o Java encontra o extrator e o banco (padrões servem para rodar local).
EXTRACTOR_URL=http://localhost:8000
DATABASE_URL=jdbc:postgresql://localhost:5432/healthstaff

# --- Autenticação (java-backend) ---
# Chave que assina os tokens JWT. Obrigatória: o backend não sobe sem ela.
# Pelo menos 32 caracteres; gere com: openssl rand -base64 48
HEALTHSTAFF_JWT_SECRET=
# Validade do token (ex.: 8h, 30m).
HEALTHSTAFF_JWT_EXPIRACAO=8h
# Primeiro administrador: criado na subida só se ainda não existir nenhum ADMIN ativo.
# Senha com 12 caracteres ou mais. Depois de criado, pode apagar a senha daqui.
HEALTHSTAFF_ADMIN_NOME=Administrador
HEALTHSTAFF_ADMIN_EMAIL=
HEALTHSTAFF_ADMIN_SENHA=
