# Copie para .env (não versionado) e ajuste. Usado pelo docker-compose.yml.

# Chave exigida no cabeçalho X-API-Key. Vazio = sem autenticação (só local).
EXTRACTOR_API_KEY=

# Tamanho máximo de cada arquivo enviado, em MB.
EXTRACTOR_MAX_UPLOAD_MB=20

# Porta publicada em 127.0.0.1 na sua máquina.
EXTRACTOR_PORTA_LOCAL=8000
