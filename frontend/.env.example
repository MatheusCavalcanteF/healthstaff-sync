# URL do java-backend (padrão: http://localhost:8080/api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Limite de upload do repasse /api/backend, igual ao do backend e do extrator (padrão 20).
EXTRACTOR_MAX_UPLOAD_MB=20

# Limite de login por IP (20 tentativas sem acerto a cada 15 min). Só atrás de um
# proxy reverso confiável: informe o cabeçalho que ELE define, "x-real-ip" ou
# "x-forwarded-for" (deste, vale o último endereço). Vazio = limite por IP
# desligado; continua valendo o limite por e-mail do backend.
HEALTHSTAFF_CABECALHO_IP=
